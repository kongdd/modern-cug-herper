    "\\frac": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\frac",
        "body": [
            "\\frac{$1}{}"
        ]
    },
    "\\h1": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\h1",
        "body": [
            "<h1>$1</h1>"
        ]
    },
    "\\h2": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\h2",
        "body": [
            "<h2>$1</h2>"
        ]
    },
    "\\h3": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\h3",
        "body": [
            "<h3>$1</h3>"
        ]
    },
    "\\h4": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\h4",
        "body": [
            "<h4>$1</h4>"
        ]
    },
    "\\h5": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\h5",
        "body": [
            "<h5>$1</h5>"
        ]
    },
    "\\v": {
        "scope": "markdown",
        "prefix": "\\v",
        "body": [
            "<div style=\"height: 0.$1em;\"></div>"
        ]
    },
    "\\div": {
        "scope": "markdown",
        "prefix": "\\div",
        "body": [
            "<div style=\"height: 0.$1em;\">",
            "$1",
            "</div>"
        ]
    },
    "\\p": {
        "scope": "markdown",
        "prefix": "\\p",
        "body": [
            "<p style=\"line-height: 2;\">",
            "$1",
            "</p>"
        ]
    },
    "\\script": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\script",
        "body": [
            "<style scoped>",
            "$1",
            "</style>"
        ]
    },
    "\\align": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\align",
        "body": [
            "$$",
            "\\begin{align*}",
            "$1",
            "\\end{align*}\n$$"
        ]
    },
    "\\eq": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\eq",
        "body": [
            "$$\n$1",
            "$$"
        ],
        "description": "$$"
    },
    "\red": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\red",
        "body": [
            "<span style='color:red'>$1</span>"
        ],
        "description": "\red"
    },
    "\\yellow_background": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\yellow",
        "body": [
            "<span style='background-color:yellow'>$1</span>"
        ],
        "description": "\red"
    },
    "red": {
        "scope": "markdown,rmd,quarto",
        "prefix": "red",
        "body": [
            "<span style='color:red'>$1</span>"
        ],
        "description": "red"
    },
    "\\image": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\image",
        "body": [
            "![]($1)"
        ],
        "description": "insert image"
    },
    "---": {
        "scope": "markdown,rmd,quarto",
        "prefix": "\\---",
        "body": [
            "---\n\n$1"
        ],
        "description": "insert image"
    },
    "Markdown comment": {
        "scope": "markdown,rmd,quarto",
        "prefix": "comment",
        "body": [
            "<!--- \n --->"
        ],
        "description": "A Markdown comment"
    }
}
