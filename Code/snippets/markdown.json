{
  // Place your snippets for markdown here. Each snippet is defined under a snippet name and has a prefix, body and
  // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
  // same ids are connected.
  // Example:
  // "Print to console": {
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "\\twocols": {
    "prefix": "\\twocols",
    "body": [
      "# $1\n",
      "<div class='grid grid-cols-2 gap-0'>",
      "<div>\n",
      "## Column 1\n",
      "</div>\n\n",
      "<div>\n",
      "## Column 2\n",
      "</div>\n"
    ]
  },
  "\\block": {
    "prefix": "\\block",
    "body": [
      ":::block",
      "$1",
      ":::"
    ]
  },
  "\\footnote": {
    "prefix": "\\footnote",
    "body": [
      ":::footnote",
      "$1",
      ":::"
    ]
  },
  "\\info": {
    "prefix": "\\info",
    "body": [
      ":::info",
      "$1",
      ":::"
    ]
  },
  "\\warn": {
    "prefix": "\\warn",
    "body": [
      ":::warn",
      "$1",
      ":::"
    ]
  },
  "\\frac": {
    
    "prefix": "\\frac",
    "body": ["\\frac{$1}{}"]
  },
  "\\h1": {
    
    "prefix": "\\h1",
    "body": ["<h1>$1</h1>"]
  },
  "\\h2": {
    
    "prefix": "\\h2",
    "body": ["<h2>$1</h2>"]
  },
  "\\h3": {
    // 
    "prefix": "\\h3",
    "body": ["<h3>$1</h3>"]
  },
  "\\h4": {
    // 
    "prefix": "\\h4",
    "body": ["<h4>$1</h4>"]
  },
  "\\h5": {
    // 
    "prefix": "\\h5",
    "body": ["<h5>$1</h5>"]
  },
  "\\script": {
    // 
    "prefix": "\\script",
    "body": ["<style scoped>", "$1", "</style>"]
  },
  "\\align": {
    
    "prefix": "\\align",
    "body": ["$$", "\\begin{align*}", "$1", "\\end{align*}\n$$"]
  },
  "\\eq": {
    // 
    "prefix": "\\eq",
    "body": ["$$\n$1", "$$"],
    "description": "$$"
  },
  "\red": {
    // 
    "prefix": "\red",
    "body": ["<span style='color:red'>$1</span>"],
    "description": "\red"
  },
  "\\yellow_background": {
    // 
    "prefix": "\\yellow",
    "body": ["<span style='color:red;background-color:yellow'>$1</span>"],
    "description": "\\yellow"
  },
  "red": {
    
    "prefix": "red",
    "body": ["<span style='color:red'>$1</span>"],
    "description": "red"
  },
  "\\image": {
    
    "prefix": "\\image",
    "body": ["![]($1)"],
    "description": "insert image"
  },
  "---": {
    
    "prefix": "\\---",
    "body": ["---\n\n$1"],
    "description": "insert image"
  },
  "Markdown comment": {
    
    "prefix": "comment",
    "body": ["<!--- \n --->"],
    "description": "A Markdown comment"
  }
}
